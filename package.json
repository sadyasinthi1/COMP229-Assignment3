{
  "name": "comp229-myportfolio",
  "version": "1.0.0",
  "private": true,
  "description": "COMP229 Assignment 3 - Full Stack Portfolio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm --prefix client/sadya-react-portfolio run dev\"",
    "client:dev": "npm --prefix client/sadya-react-portfolio run dev",
    "client:build": "npm --prefix client/sadya-react-portfolio run build",
    "seed:admin": "node scripts/seed-admin.js",
    "check": "node --check server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.5",
    "nodemon": "^3.1.9"
  }
}
