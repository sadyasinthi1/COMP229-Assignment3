{
  "info": {
    "name": "COMP229 Assignment 3 - Portfolio API Tests",
    "description": "Sign in as Admin FIRST; set adminEmail/adminPassword variables to match your own .env. All write routes require an Admin JWT. Demo requests use sample data only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Health and authentication",
      "item": [
        {
          "name": "GET - backend health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health",
            "description": "GET /api/health"
          },
          "response": []
        },
        {
          "name": "POST - Admin sign-in (save JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signin",
            "description": "POST /api/auth/signin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin sign-in succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const r = pm.response.json(); pm.collectionVariables.set('adminToken', r.token); pm.test('Admin role returned', () => pm.expect(r.user.role).to.eql('admin')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - Admin profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/profile",
            "description": "GET /api/auth/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2 - Admin Project CRUD",
      "item": [
        {
          "name": "POST - create Project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "description": "POST /api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"COMP229 Sample Project\",\n  \"firstname\": \"Example\",\n  \"lastname\": \"Student\",\n  \"email\": \"sample@example.com\",\n  \"completion\": \"2026-11-13\",\n  \"description\": \"Sample project saved from Postman for CRUD verification.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Project created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) pm.collectionVariables.set('projectId', pm.response.json()._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - all Projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects",
            "description": "GET /api/projects"
          },
          "response": []
        },
        {
          "name": "GET - project by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "GET /api/projects/{{projectId}}"
          },
          "response": []
        },
        {
          "name": "PUT - update Project",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "PUT /api/projects/{{projectId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"COMP229 Updated Sample Project\",\n  \"firstname\": \"Example\",\n  \"lastname\": \"Student\",\n  \"email\": \"sample@example.com\",\n  \"completion\": \"2026-11-13\",\n  \"description\": \"Updated via Admin JWT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "DELETE - project by ID",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/projects/{{projectId}}",
            "description": "DELETE /api/projects/{{projectId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3 - Regular User permissions",
      "item": [
        {
          "name": "POST - public Sign Up (User role only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users",
            "description": "POST /api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sample Regular User\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.test('Public signup cannot create admin', () => pm.expect(pm.response.json().role).to.eql('user'));",
                  "pm.test('New user created or already exists', () => pm.expect([201,409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST - User sign-in (save user JWT)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/signin",
            "description": "POST /api/auth/signin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User sign-in succeeds', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) { const r = pm.response.json(); pm.collectionVariables.set('userToken', r.token); pm.test('Regular role returned', () => pm.expect(r.user.role).to.eql('user')); }"
                ]
              }
            }
          ]
        },
        {
          "name": "GET - User can read projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/projects",
            "description": "GET /api/projects",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "POST - User forbidden to create project (expect 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/projects",
            "description": "POST /api/projects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Must Fail\",\n  \"firstname\": \"Test\",\n  \"lastname\": \"Student\",\n  \"email\": \"test@example.com\",\n  \"completion\": \"2026-11-13\",\n  \"description\": \"This should not be saved.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Non-admin write forbidden', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Sign-out",
      "item": [
        {
          "name": "GET - Admin sign-out (required by handout)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/signout",
            "description": "GET /auth/signout",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - signed-out token denied (expect 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/auth/profile",
            "description": "GET /api/auth/profile",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Revoked token rejected', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "adminEmail",
      "value": "your-admin-email@example.com"
    },
    {
      "key": "adminPassword",
      "value": "SET_YOUR_REAL_ADMIN_PASSWORD_IN_POSTMAN"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": "sample-user@example.com"
    },
    {
      "key": "userPassword",
      "value": "SampleUserPassword123!"
    },
    {
      "key": "userToken",
      "value": ""
    }
  ]
}